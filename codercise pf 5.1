import numpy as np
import pennylane as qp

n_shots = 10000
dev = qp.device("default.qubit", shots=n_shots)
np.random.seed(0)


@qp.qnode(dev)
def circuit():
    qp.Hadamard(wires=0)
    m_bomb = qp.measure(0, postselect=0)
    qp.Hadamard(wires=0)
    m_det = qp.measure(0)
    return qp.counts(m_bomb), qp.counts(m_det)


print("--- INICIO DIAGNÓSTICO ---")

# 1. Evaluamos la función
results = circuit()

print("1. Tipo de 'results':", type(results))
print("2. Contenido de 'results':", results)

# 2. Intentamos acceder al índice 1
try:
    counts_det = results[1]
    print("3. Tipo de 'counts_det':", type(counts_det))
    print("4. Contenido de 'counts_det':", counts_det)
except Exception as e:
    print("ERROR EN 'results[1]':", e)

# 3. Intentamos hacer el .get()
try:
    prob_suc = counts_det.get(1.0, 0) / n_shots
    print("5. ÉXITO -> Probabilidad:", prob_suc)
except Exception as e:
    print("ERROR EN '.get()':", e)

print("--- FIN DIAGNÓSTICO ---")
